  Consumer -- (Customize Wall Art)
  Consumer -- (Upload Custom Design)
  Consumer -- (Generate Preview)
  Consumer -- (Confirm Order)
  Consumer -- (Revise Order)
  Consumer -- (Receive Issue Notification)

  ' Production team flows
  ProdTeam -- (Produce Custom Piece)
  ProdTeam -- (Ship Product)

  ' Inventory flows
  (Track Material Stock)
  (Reorder Materials)

  ' External supplier for reorders
  Supplier -- (Reorder Materials)

  ' include/extend relationships
